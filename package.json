{
  "name": "postpost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/create-pages-routes.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/validation.test.mjs tests/content.test.mjs tests/profile.test.mjs",
    "test:rules": "npx --yes firebase-tools@15.35.0 emulators:exec --only firestore --project demo-postpost \"node --test tests/firestore.rules.test.mjs\"",
    "test:e2e": "npx --yes firebase-tools@15.35.0 emulators:exec --only auth,firestore,functions --project demo-postpost \"playwright test\"",
    "test:functions": "npm --prefix functions test"
  },
  "dependencies": {
    "firebase": "13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "8.3.6"
  }
}
