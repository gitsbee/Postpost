rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['body', 'authorId', 'authorName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['body', 'authorId', 'authorName', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && request.resource.data.body.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
