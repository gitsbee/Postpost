rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Retired login-service records, if any, remain inaccessible to clients.
    match /loginAttempts/{id} { allow read, write: if false; }
    match /users/{uid}/activity/{activityId} {
      function own() { return request.auth != null && request.auth.uid == uid; }
      function source(data) {
        let postId = data.postId;
        let reaction = /databases/$(database)/documents/posts/$(postId)/reactions/$(uid);
        let repost = /databases/$(database)/documents/posts/$('repost_' + uid + '_' + postId);
        return data.postId is string && data.postId.matches('[^/]+') && (
          (data.kind in ['like', 'dislike'] && activityId == 'reaction_' + postId && existsAfter(reaction) && getAfter(reaction).data.kind == data.kind)
          || (data.kind == 'repost' && activityId == 'repost_' + postId && existsAfter(repost) && getAfter(repost).data.deleted == false));
      }
      allow read: if own();
      allow create, update: if own() && request.resource.data.keys().hasAll(['postId', 'kind', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['postId', 'kind', 'updatedAt']) && request.resource.data.updatedAt == request.time && source(request.resource.data);
      allow delete: if own() && (!exists(/databases/$(database)/documents/users/$(uid)/activity/$(activityId)) || !source(resource.data));
    }
    function validHandle(handle) { return handle is string && handle.matches('[a-z][a-z0-9_]{2,19}'); }
    function profileRef(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function limitRef(uid) { return /databases/$(database)/documents/profileLimits/$(uid); }
    function handleRef(handle) { return /databases/$(database)/documents/handles/$(handle); }
    function validSocial(links, index) {
      return links.size() <= index || (links[index] is string && links[index].size() <= 500
        && links[index].matches('https://[^\\s/@:]+(\\.[^\\s/@:]+)+(:[0-9]+)?([/?#][^\\s]*)?'));
    }
    function validProfile(data) {
      return data.keys().hasAll(['name', 'handle', 'bio', 'links', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'handle', 'bio', 'links', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 30 && data.name.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && validHandle(data.handle) && data.bio is string && data.bio.size() <= 1000
        && data.links is list && data.links.size() <= 5 && data.links.toSet().size() == data.links.size()
        && validSocial(data.links, 0) && validSocial(data.links, 1) && validSocial(data.links, 2) && validSocial(data.links, 3) && validSocial(data.links, 4)
        && data.updatedAt == request.time
        && getAfter(handleRef(data.handle)).data.uid == request.auth.uid;
    }
    match /profiles/{uid} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == uid && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && getAfter(limitRef(uid)).data.last == null && getAfter(limitRef(uid)).data.previous == null;
      allow update: if request.auth != null && request.auth.uid == uid && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'handle', 'bio', 'links', 'updatedAt'])
        && (request.resource.data.handle == resource.data.handle || (
          !existsAfter(handleRef(resource.data.handle))
          && getAfter(limitRef(uid)).data.last == request.time
          && getAfter(limitRef(uid)).data.previous == get(limitRef(uid)).data.last
          && (get(limitRef(uid)).data.previous == null || get(limitRef(uid)).data.previous <= request.time - duration.value(14, 'd'))));
      allow delete: if false;
    }
    match /handles/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && validHandle(handle)
        && request.resource.data.keys().hasAll(['uid']) && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(profileRef(request.auth.uid)).data.handle == handle;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && getAfter(profileRef(request.auth.uid)).data.handle != handle;
    }
    match /profileLimits/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['last', 'previous']) && request.resource.data.keys().hasOnly(['last', 'previous'])
        && request.resource.data.last == null && request.resource.data.previous == null
        && !exists(profileRef(uid)) && getAfter(profileRef(uid)).data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['last', 'previous']) && request.resource.data.keys().hasOnly(['last', 'previous'])
        && request.resource.data.last == request.time && request.resource.data.previous == resource.data.last
        && (resource.data.previous == null || resource.data.previous <= request.time - duration.value(14, 'd'))
        && get(profileRef(uid)).data.handle != getAfter(profileRef(uid)).data.handle;
      allow delete: if false;
    }

    match /posts/{postId} {
      function signedIn() { return request.auth != null; }
      function owner() { return signedIn() && resource.data.authorId == request.auth.uid; }
      function nonblank(value, maximum) {
        return value is string && value.size() >= 1 && value.size() <= maximum
          && value.matches('[\\s\\S]*[^\\s][\\s\\S]*');
      }
      function fields(data) {
        return data.keys().hasAll(['body', 'authorId', 'authorName', 'createdAt'])
          && data.keys().hasOnly(['body', 'authorId', 'authorName', 'createdAt', 'kind', 'originalId', 'tags', 'deleted', 'updatedAt'])
          && nonblank(data.authorName, 30)
          && data.get('tags', []) is list && data.get('tags', []).size() <= 10
          && data.get('deleted', false) is bool;
      }
      function originalExists(data) {
        let id = data.originalId;
        let path = /databases/$(database)/documents/posts/$(id);
        return id is string && id.matches('[^/]+')
          && exists(path) && get(path).data.get('kind', 'post') == 'post'
          && get(path).data.get('deleted', false) == false;
      }
      function content(data) {
        return (data.get('kind', 'post') == 'post' && data.get('originalId', null) == null && nonblank(data.body, 2000))
          || (data.get('kind', 'post') == 'repost' && data.body == '' && data.get('tags', []) == [] && originalExists(data)
            && postId == 'repost_' + request.auth.uid + '_' + data.originalId);
      }
      allow read: if true;
      allow create: if signedIn() && fields(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(['updatedAt'])
        && request.resource.data.get('deleted', false) == false
        && content(request.resource.data);
      allow update: if owner() && fields(request.resource.data) && (
        // Normal edit or content-erasing soft deletion; identity never changes.
        (resource.data.get('deleted', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'tags', 'updatedAt', 'deleted'])
          && request.resource.data.updatedAt == request.time
          && ((request.resource.data.get('deleted', false) == true && request.resource.data.body == '' && request.resource.data.get('tags', []) == [])
            || (resource.data.get('kind', 'post') == 'post' && request.resource.data.get('deleted', false) == false && content(request.resource.data))))
        // Reposting a previously removed reference reuses its deterministic ID.
        || (resource.data.get('kind', 'post') == 'repost' && resource.data.get('deleted', false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'createdAt'])
          && request.resource.data.deleted == false && request.resource.data.createdAt == request.time && content(request.resource.data))
      );
      allow delete: if false;

      function parent() { return get(/databases/$(database)/documents/posts/$(postId)).data; }
      function reactable() { return signedIn() && parent().get('deleted', false) == false && parent().get('kind', 'post') == 'post'; }
      function beforeKind() {
        let path = /databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid);
        return exists(path) ? get(path).data.kind : 'none';
      }
      function afterKind() {
        let path = /databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid);
        return existsAfter(path) ? getAfter(path).data.kind : 'none';
      }
      function oldCount(key) {
        let path = /databases/$(database)/documents/posts/$(postId)/stats/reactions;
        return exists(path) ? get(path).data[key] : 0;
      }
      function delta(kind) { return (afterKind() == kind ? 1 : 0) - (beforeKind() == kind ? 1 : 0); }
      function validCounts(data) {
        return data.keys().hasAll(['likes', 'dislikes']) && data.keys().hasOnly(['likes', 'dislikes'])
          && data.likes is int && data.dislikes is int && data.likes >= 0 && data.dislikes >= 0
          && data.likes == oldCount('likes') + delta('like')
          && data.dislikes == oldCount('dislikes') + delta('dislike');
      }
      match /reactions/{uid} {
        // Only the author can list identities. A reactor can get their own choice.
        allow get: if signedIn() && (request.auth.uid == uid || parent().authorId == request.auth.uid);
        allow list: if signedIn() && parent().authorId == request.auth.uid;
        allow create, update: if reactable() && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['kind', 'name']) && request.resource.data.keys().hasOnly(['kind', 'name'])
          && request.resource.data.kind in ['like', 'dislike'] && nonblank(request.resource.data.name, 30)
          && validCounts(getAfter(/databases/$(database)/documents/posts/$(postId)/stats/reactions).data);
        allow delete: if reactable() && request.auth.uid == uid
          && validCounts(getAfter(/databases/$(database)/documents/posts/$(postId)/stats/reactions).data);
      }
      match /stats/{statId} {
        allow read: if true;
        allow create, update: if statId == 'reactions' && reactable() && validCounts(request.resource.data);
        allow delete: if false;
      }
    }
  }
}
